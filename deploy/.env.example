# ArcReel 默认部署环境配置（SQLite）
# 复制为 .env 后填入你的值

# ============================================================
# 认证配置 (Authentication)
# ============================================================
# 登录用户名（默认: admin）
AUTH_USERNAME=admin
# 登录密码（留空则首次启动时自动生成并回写到 .env 文件）
# 修改本文件后执行 docker compose up -d 重建容器才会生效，docker compose restart 不会重新载入
AUTH_PASSWORD=
# JWT 签名密钥（留空则自动生成并保存到 projects/runtime/auth-token-secret，重启后登录不失效；
# 在此设置时以设置值为准）
AUTH_TOKEN_SECRET=

# ============================================================
# 日志配置 (Logging)
# ============================================================
# 日志级别（默认: INFO，可选: DEBUG, WARNING, ERROR）
# LOG_LEVEL=INFO

# SaaS bridge (optional)
# DEPLOYMENT_MODE=self_hosted
# CONTROL_PLANE_URL=http://127.0.0.1:8100
# CONTROL_PLANE_JWT_SECRET=
# CONTROL_PLANE_INTERNAL_TOKEN=
# CONTROL_PLANE_ADMIN_TOKEN=
# SAAS_HOLD_ESTIMATE_CREDITS=10
# SAAS_COST_TO_CREDITS_MULTIPLIER=1.0
